@model Inventario
@{
    ViewData["Title"] = "Editar Inventario";
}

<div class="container mt-4">
    <h2>Editar Registro de Inventario</h2>

    <form asp-action="Edit" asp-route-id="@Model.InventarioID" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input asp-for="InventarioID" type="hidden" />

        <div class="mb-3">
            <label asp-for="FechaIngreso" class="form-label">Fecha de ingreso</label>
            <input asp-for="FechaIngreso" type="date" class="form-control">
        </div>

        <div class="mb-3">
            <label asp-for="Cantidad" class="form-label">Cantidad</label>
            <input asp-for="Cantidad" type="number" class="form-control">
        </div>

        <div class="mb-3">
            <label asp-for="Ubicacion" class="form-label">Ubicación</label>
            <input asp-for="Ubicacion" type="text" class="form-control">
        </div>

        <div class="mb-3">
            <label asp-for="Estado" class="form-label">Estado</label>
            <select asp-for="Estado" class="form-select">
                <option>Disponible</option>
                <option>Dañado</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ProductoID" class="form-label">Producto ID</label>
            <select asp-for="ProductoID" asp-items="ViewBag.ProductoID" class="form-select"><option value="">Seleccione un producto</option></select>
        </div>

        <button type="submit" class="btn btn-success">
            Actualizar
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Regresar
        </a>
    </form>
</div>

