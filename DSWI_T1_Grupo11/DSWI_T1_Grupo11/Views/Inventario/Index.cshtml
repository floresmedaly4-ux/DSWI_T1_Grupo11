@model IEnumerable<Inventario>
@{
    ViewData["Title"] = "Inventario";
}

<div class="container mt-4">
    <h2>Gestión de Inventario</h2>
    <p>Administración de los productos registrados en el inventario.</p>

    <a asp-action="Create" class="btn btn-primary mb-3">Nuevo Registro</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Fecha de ingreso</th>
                <th>Cantidad</th>
                <th>Ubicación</th>
                <th>Estado</th>
                <th>Producto ID</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.InventarioID</td>
                <td>@(item.FechaIngreso?.ToString("dd/MM/yyyy"))</td>
                <td>@item.Cantidad</td>
                <td>@item.Ubicacion</td>
                <td>@item.Estado</td>
                <td>@item.ProductoID</td>
                <td><a asp-action="Edit" asp-route-id="@item.InventarioID" class="btn btn-warning btn-sm">Editar</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
