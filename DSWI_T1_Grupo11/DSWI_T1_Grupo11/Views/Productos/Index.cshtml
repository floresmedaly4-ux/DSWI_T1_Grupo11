@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-4">
    <h2>Gestión de Productos</h2>
    <p>Administración de los productos del inventario.</p>

    <a asp-action="Create" class="btn btn-primary mb-3">Nuevo Producto</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductoID</td>
                <td>@item.Nombre</td>
                <td>@item.Categoria</td>
                <td><a asp-action="Edit" asp-route-id="@item.ProductoID" class="btn btn-warning btn-sm">Editar</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
