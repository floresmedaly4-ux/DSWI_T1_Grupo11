@model Producto
@{
    ViewData["Title"] = "Registrar Producto";
}

<div class="container mt-4">
    <h2>Registrar Nuevo Producto</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre del producto</label>
            <input asp-for="Nombre" type="text" class="form-control"
                   placeholder="Ingrese el nombre del producto">
        </div>

        <div class="mb-3">
            <label asp-for="Categoria" class="form-label">Categoría</label>
            <input asp-for="Categoria" type="text" class="form-control"
                   placeholder="Ingrese la categoría">
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">Regresar</a>
    </form>
</div>

